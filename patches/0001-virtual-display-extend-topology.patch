From 1e1c4ce0d753c55a5ac5475a20e8703ad9791d1b Mon Sep 17 00:00:00 2001
From: shohamh <shohamh@hotmail.com>
Date: Sat, 10 Oct 2026 15:06:06 +0300
Subject: [PATCH] virtual display: make new displays attach reliably (extend
 topology, wait longer)

After AddVirtualDisplay, Apollo waited about 0.6 s for the new display to appear as an active, separate monitor.
Windows sometimes attaches it as a clone of the main screen on the physical GPU's adapter instead (a saved display
configuration for that monitor identity can cause this). The expected target then never becomes active, so
"Virtual Display creation failed" is logged and the stream shows the real screen instead of a new monitor.

Poll for up to 8 s and, if the display has not appeared as its own path after 400 ms, ask Windows once for an
extended topology (SetDisplayConfig with SDC_TOPOLOGY_EXTEND). That also repairs the saved configuration, so later
launches resolve in tens of milliseconds.

Reproduced on demand (force a clone topology while a virtual display is active, quit, relaunch): the stock build
fails every time, this build recovers. Part of the LANDock project (https://github.com/shohamh/LANDock).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/platform/windows/virtual_display.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/platform/windows/virtual_display.cpp b/src/platform/windows/virtual_display.cpp
index 7c64983..522874a 100644
--- a/src/platform/windows/virtual_display.cpp
+++ b/src/platform/windows/virtual_display.cpp
@@ -671,16 +671,30 @@ std::wstring createVirtualDisplay(
 		return std::wstring();
 	}
 
+	// LANDock: the stock wait gives up after ~0.6 s; some displays take longer to appear.
 	uint32_t retryInterval = 20;
+	uint32_t waited = 0;
+	bool extended = false;
 	wchar_t deviceName[CCHDEVICENAME]{};
 	while (!GetAddedDisplayName(output, deviceName)) {
 		Sleep(retryInterval);
-		if (retryInterval > 320) {
+		waited += retryInterval;
+		// LANDock: Windows may attach the new monitor as a clone on the physical adapter, so the expected target
+		// never becomes active. Ask for an extended topology once, early, then keep polling.
+		if (!extended && waited >= 400) {
+			extended = true;
+			LONG r = SetDisplayConfig(0, nullptr, 0, nullptr, SDC_APPLY | SDC_TOPOLOGY_EXTEND);
+			printf("[SUDOVDA] Forced extend topology after %u ms, result %ld\n", waited, r);
+		}
+		if (waited > 8000) {
 			printf("[SUDOVDA] Cannot get name for newly added virtual display!\n");
 			return std::wstring();
 		}
-		retryInterval *= 2;
+		if (retryInterval < 320) {
+			retryInterval *= 2;
+		}
 	}
+	printf("[SUDOVDA] Display name resolved after %u ms\n", waited);
 
 	wprintf(L"[SUDOVDA] Virtual display added successfully: %ls\n", deviceName);
 	printf("[SUDOVDA] Configuration: W: %d, H: %d, FPS: %d\n", width, height, fps);
-- 
