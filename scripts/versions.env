# Pinned sources for everything LANDock builds from source. Read by scripts/*.sh, scripts/*.ps1 and the workflows.
#
# Apollo and Moonlight are kept as FORKS owned by this project's author. Our own changes live as commits on the
# `landock` branch of each fork, on top of an upstream release tag. Builds use the exact commit pinned here, so a build
# never changes by surprise. To pull upstream changes in later, see docs/upstream-sync.md (scripts/sync-upstream.sh).

# --- Apollo (a Sunshine fork by ClassicOldSong): the host. Built from source. -------------------------------------
APOLLO_REPO=https://github.com/shohamh/Apollo.git
APOLLO_REF=landock
APOLLO_COMMIT=bffd7baef467a6b5191088a65e7524ad195efd47
APOLLO_UPSTREAM_REPO=ClassicOldSong/Apollo
APOLLO_UPSTREAM_BASE=v0.4.8

# --- Moonlight (moonlight-qt): the client. Built from source in CI; the official release below is the fallback. ----
MOONLIGHT_REPO=https://github.com/shohamh/moonlight-qt.git
MOONLIGHT_REF=landock
MOONLIGHT_COMMIT=de2467e433821664cdd2224aad8c89a625be1ad9
MOONLIGHT_UPSTREAM_REPO=moonlight-stream/moonlight-qt
MOONLIGHT_UPSTREAM_BASE=v6.2.0
MOONLIGHT_QT_VERSION=6.12.0

# Official Moonlight release (unmodified), used when a client package is made without building Moonlight.
MOONLIGHT_VERSION=6.2.0
MOONLIGHT_URL=https://github.com/moonlight-stream/moonlight-qt/releases/download/v6.2.0/MoonlightPortable-x64-6.2.0.zip
MOONLIGHT_SHA256=6f91d268b41ed5ca8066d9d7578dc403b8db190991ff48f00b1700465f8f7ebf

# --- Boost for the Apollo build. The v0.4.8 tag pins an older hash of this tarball than the file GitHub serves today;
# the hash below is the one Apollo's master pins and the one the file matches. --------------------------------------
BOOST_VERSION=1.89.0
BOOST_URL=https://github.com/boostorg/boost/releases/download/boost-1.89.0/boost-1.89.0-cmake.tar.xz
BOOST_SHA256=67acec02d0d118b5de9eb441f5fb707b3a1cdd884be00ca24b9a73c995511f74

# ggwave (MIT): data over sound, used for the ultrasound desktop identification (see docs/plan-discovery-and-proximity.md)
GGWAVE_REPO=https://github.com/ggerganov/ggwave.git
GGWAVE_COMMIT=060aec73dd7123ccac200442f75bdc7369795ffe
